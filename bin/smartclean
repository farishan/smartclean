#!/usr/bin/env bash
# smartclean — smart disk cleaner on top of Mole (macOS) + OpenCode
# Default mode is SCAN (no changes). Use --apply to delete (with confirmation).
set -o pipefail

SC_HOME="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=lib/safety.sh
source "$SC_HOME/lib/safety.sh"

KEEP_DAYS=7
DEEP=0
TARGET=""
JSON=0
APPLY=0
DRY_RUN=1
CATEGORIES="all"
MIN_LARGE_MB=100
SCAN_TIMEOUT=180
BROWSERS=(google-chrome chromium BraveSoftware microsoft-edge vivaldi opera)

usage() {
  cat <<EOF
${C_BOLD}smartclean${C_RESET} — smart disk cleaner (v$SMARTCLEAN_VERSION)

${C_BOLD}Usage:${C_RESET} smartclean [scan|apply] [options]

Default command is ${C_BOLD}scan${C_RESET}: analyze and report, delete nothing.
Use ${C_BOLD}apply${C_RESET} (or --apply) to actually delete (confirms per category).

${C_BOLD}Options:${C_RESET}
  --deep                include deep sweeps (all of ~/Library/Caches, unused images, cold caches)
  --keep-days N         protect caches/projects used within N days (default $KEEP_DAYS)
  --target DIR          tree to scan for build artifacts / large files (default ~/dev or \$HOME)
  --category LIST       comma list: trash,browsers,dev,cache,system,snap,flatpak,docker,artifacts,installers,large (default all)
  --min-large MB        large-file threshold (default $MIN_LARGE_MB)
  --timeout SEC         max seconds per scan (default $SCAN_TIMEOUT)
  --json                machine-readable output (scan only)
  --yes                 skip confirmations (apply mode)
  --dry-run             force preview even with --apply
  -h, --help            this help

${C_BOLD}Examples:${C_RESET}
  smartclean                      # full scan, no changes
  smartclean scan --json          # JSON report for tooling
  smartclean apply --yes          # apply all (careful)
  smartclean apply --category artifacts --target ~/dev
  smartclean scan --deep --keep-days 14
EOF
}

# ---------- arg parsing ----------
CMD="scan"
ARGS=()
while (($#)); do
  case "$1" in
    scan|apply) CMD="$1"; [[ $1 == apply ]] && APPLY=1 ;;
    --deep) DEEP=1 ;;
    --keep-days) KEEP_DAYS="$2"; shift ;;
    --target) TARGET="$2"; shift ;;
    --category) CATEGORIES="$2"; shift ;;
    --min-large) MIN_LARGE_MB="$2"; shift ;;
    --timeout) SCAN_TIMEOUT="$2"; shift ;;
    --json) JSON=1 ;;
    --yes) ASSUME_YES=1 ;;
    --dry-run) DRY_RUN=1; APPLY=0 ;;
    --apply) APPLY=1; DRY_RUN=0 ;;
    -h|--help) usage; exit 0 ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done
# scan is always dry-run
[[ $CMD == scan ]] && { DRY_RUN=1; APPLY=0; }

[[ -z $TARGET ]] && { [[ -d $HOME/dev ]] && TARGET="$HOME/dev" || TARGET="$HOME"; }
TARGET=$(normalize_path "$TARGET")

cat_in() { [[ ",$CATEGORIES," == *,all,* || ",$CATEGORIES," == *,$1,* ]]; }

# ---------- report state ----------
CANDS=()
SKIPS=()
add_cand() { # size category path reason
  local p=$3 existing f3
  for existing in "${CANDS[@]}"; do
    f3=${existing#*$'\t'}; f3=${f3#*$'\t'}; f3=${f3%%$'\t'*}
    [[ "$f3" == "$p" ]] && return 0
  done
  CANDS+=("$1"$'\t'"$2"$'\t'"$3"$'\t'"$4")
}
add_skip() { SKIPS+=("$1"$'\t'"$2"); }  # path reason

# ---------- bounded scan wrapper ----------
bounded_find() {
  timeout "$SCAN_TIMEOUT" find "$@" 2>/dev/null
  local rc=$?
  if (( rc == 124 )); then
    printf 'SCAN-TIMEOUT' >&2
  fi
}

# ---------- category: trash ----------
scan_trash() {
  cat_in trash || return 0
  local p
  for p in "$HOME/.Trash" "$HOME/.local/share/Trash/files" "$HOME/.local/share/Trash/info" "$HOME/.cache/thumbnails" "$HOME/Library/Caches/com.apple.QuickLook.thumbnailcache"; do
    [[ -e $p ]] || continue
    local sz age
    sz=$(path_size "$p"); (( sz > 0 )) || continue
    age=$(path_age_days "$p")
    add_cand "$sz" "trash" "$p" "trash (age ${age}d)"
  done
}

# ---------- category: browsers ----------
scan_browsers() {
  cat_in browsers || return 0
  local entry proc path sz age
  local -a entries=(
    "google-chrome|$HOME/.cache/google-chrome"
    "google-chrome|$HOME/snap/google-chrome/common/.cache"
    "google-chrome|$HOME/Library/Caches/Google/Chrome"
    "chromium|$HOME/.cache/chromium"
    "chromium|$HOME/Library/Caches/Chromium"
    "BraveSoftware|$HOME/.cache/BraveSoftware"
    "BraveSoftware|$HOME/Library/Caches/BraveSoftware/Brave-Browser"
    "microsoft-edge|$HOME/.cache/microsoft-edge"
    "microsoft-edge|$HOME/Library/Caches/Microsoft Edge"
    "vivaldi|$HOME/.cache/vivaldi"
    "vivaldi|$HOME/Library/Caches/Vivaldi"
    "opera|$HOME/.cache/opera"
    "opera|$HOME/Library/Caches/com.operasoftware.Opera"
  )
  for entry in "${entries[@]}"; do
    proc="${entry%%|*}"; path="${entry##*|}"
    [[ -d $path ]] || continue
    cache_candidate_ok "$path" || { add_skip "$path" "sensitive/protected"; continue; }
    if browser_running "$proc"; then
      add_skip "$path" "browser running (locked)"; continue
    fi
    sz=$(path_size "$path"); (( sz > 0 )) || continue
    age=$(path_age_days "$path")
    if (( ! DEEP )) && (( age < KEEP_DAYS )); then
      add_skip "$path" "hot cache (used ${age}d ago < ${KEEP_DAYS}d)"; continue
    fi
    add_cand "$sz" "browsers" "$path" "browser cache (age ${age}d)"
  done
  # firefox special paths
  local -a ffpaths=("$HOME/.cache/mozilla" "$HOME/Library/Caches/Firefox" "$HOME/Library/Caches/Mozilla")
  for path in "${ffpaths[@]}"; do
    [[ -d $path ]] || continue
    cache_candidate_ok "$path" || { add_skip "$path" "sensitive/protected"; continue; }
    if browser_running firefox; then add_skip "$path" "browser running"; continue; fi
    sz=$(path_size "$path"); (( sz > 0 )) || continue
    age=$(path_age_days "$path")
    if (( ! DEEP )) && (( age < KEEP_DAYS )); then
      add_skip "$path" "hot cache (used ${age}d ago)"; continue
    fi
    add_cand "$sz" "browsers" "$path" "firefox cache (age ${age}d)"
  done
}

# ---------- category: dev caches ----------
scan_dev() {
  cat_in dev || return 0
  local -a pairs=(
    "$HOME/.npm/_cacache:npm cache"
    "$HOME/.cache/pip:pip cache"
    "$HOME/Library/Caches/pip:pip cache"
    "$HOME/.cache/yarn:yarn cache"
    "$HOME/Library/Caches/Yarn:yarn cache"
    "$HOME/.cache/pnpm:pnpm cache"
    "$HOME/.local/share/pnpm/store:pnpm store"
    "$HOME/Library/pnpm/store:pnpm store"
    "$HOME/.cache/go-build:go build cache"
    "$HOME/.cache/node-gyp:node-gyp cache"
    "$HOME/Library/Caches/node-gyp:node-gyp cache"
    "$HOME/.cache/uv:uv cache"
    "$HOME/.cache/pypoetry/cache:poetry cache"
    "$HOME/.cargo/registry/cache:cargo registry cache"
  )
  local entry p label sz age
  for entry in "${pairs[@]}"; do
    p="${entry%%:*}"; label="${entry##*:}"
    [[ -d $p ]] || continue
    cache_candidate_ok "$p" || { add_skip "$p" "sensitive/protected"; continue; }
    sz=$(path_size "$p"); (( sz > 0 )) || continue
    age=$(path_age_days "$p")
    if (( ! DEEP )) && (( age < KEEP_DAYS )); then
      add_skip "$p" "hot cache (used ${age}d ago)"; continue
    fi
    add_cand "$sz" "dev" "$p" "$label (age ${age}d)"
  done
  if (( DEEP )); then
    for p in "$HOME/.gradle/caches" "$HOME/.m2/repository"; do
      [[ -d $p ]] || continue
      cache_candidate_ok "$p" || { add_skip "$p" "sensitive/protected"; continue; }
      sz=$(path_size "$p"); (( sz > 0 )) || continue
      age=$(path_age_days "$p")
      add_cand "$sz" "dev" "$p" "$(basename "$p") (deep, age ${age}d)"
    done
  fi
}

# ---------- category: deep cache sweep ----------
scan_cache() {
  cat_in cache || return 0
  (( DEEP )) || return 0
  local entry sz age
  for entry in "$HOME"/.cache/* "$HOME"/.cache/.[!.]* "$HOME"/Library/Caches/*; do
    [[ -e $entry ]] || continue
    cache_candidate_ok "$entry" || { add_skip "$entry" "sensitive/protected"; continue; }
    sz=$(path_size "$entry"); (( sz > 0 )) || continue
    age=$(path_age_days "$entry")
    if (( ! DEEP )) && (( age < KEEP_DAYS )); then
      add_skip "$entry" "hot (used ${age}d ago)"; continue
    fi
    add_cand "$sz" "cache" "$entry" "leftover cache (age ${age}d)"
  done
}

# ---------- category: system ----------
scan_system() {
  cat_in system || return 0
  # brew cache (system-level helper via Mole/brew)
  if have brew; then
    local bcache
    bcache=$(brew --cache 2>/dev/null)
    if [[ -d $bcache ]]; then
      local sz; sz=$(path_size "$bcache")
      (( sz > 0 )) && add_cand "$sz" "system" "$bcache" "homebrew cache"
    fi
  fi
  # macOS user logs
  local logs_sz
  if [[ $SC_OS == Darwin ]]; then
    logs_sz=$(find "$HOME/Library/Logs" -xdev -type f \( -name '*.gz' -o -name '*.old' -o -name '*.[0-9]' \) -exec stat -f%z {} + 2>/dev/null | awk '{s+=$1} END{print s+0}')
  else
    logs_sz=$(find "$HOME/Library/Logs" -xdev -type f \( -name '*.gz' -o -name '*.old' -o -name '*.[0-9]' \) -printf '%s\n' 2>/dev/null | awk '{s+=$1} END{print s+0}')
  fi
  (( ${logs_sz:-0} > 0 )) && add_cand "$logs_sz" "system" "$HOME/Library/Logs" "rotated user logs"
  # /var/log rotated logs (if accessible)
  if [[ $SC_OS == Darwin ]]; then
    logs_sz=$(find /var/log -xdev -type f \( -name '*.gz' -o -name '*.old' -o -name '*.[0-9]' \) -exec stat -f%z {} + 2>/dev/null | awk '{s+=$1} END{print s+0}')
  else
    logs_sz=$(find /var/log -xdev -type f \( -name '*.gz' -o -name '*.old' -o -name '*.[0-9]' \) -printf '%s\n' 2>/dev/null | awk '{s+=$1} END{print s+0}')
  fi
  (( ${logs_sz:-0} > 0 )) && add_cand "$logs_sz" "system" "/var/log/*.gz,*.old,*.[0-9]" "rotated logs"
}

# ---------- category: snap ----------
scan_snap() {
  cat_in snap || return 0
  have snap || return 0
  local line
  while IFS= read -r line; do
    [[ -z $line ]] && continue
    add_cand 0 "snap" "snap:${line}" "old disabled snap revision"
  done < <(snap list --all 2>/dev/null | awk '/disabled/{print $1"="$3}')
  local snaps
  snaps=$(snap saved 2>/dev/null | tail -n +2)
  if [[ -n $snaps && $snaps != *"No snapshots"* ]]; then
    while read -r sset sname sage rest; do
      [[ $sset =~ ^[0-9]+$ ]] || continue
      add_cand 0 "snap" "snap-saved:$sset" "saved snapshot of $sname (age $sage)"
    done <<<"$snaps"
  fi
}

# ---------- category: flatpak ----------
scan_flatpak() {
  cat_in flatpak || return 0
  have flatpak || return 0
  local d app sz age
  for d in "$HOME"/.var/app/*/cache; do
    [[ -d $d ]] || continue
    cache_candidate_ok "$d" || { add_skip "$d" "sensitive/protected"; continue; }
    app=$(basename "$(dirname "$d")")
    sz=$(path_size "$d"); (( sz > 0 )) || continue
    age=$(path_age_days "$d")
    if (( ! DEEP )) && (( age < KEEP_DAYS )); then
      add_skip "$d" "hot cache (used ${age}d ago)"; continue
    fi
    add_cand "$sz" "flatpak" "$d" "flatpak cache: $app (age ${age}d)"
  done
}

# ---------- category: docker/podman ----------
scan_docker() {
  cat_in docker || return 0
  local ce
  for ce in docker podman; do
    have "$ce" || continue
    "$ce" system df >/dev/null 2>&1 || continue
    add_cand 0 "docker" "$ce" "$ce installed & reachable (dangling images/build cache)"
  done
}

# ---------- category: build artifacts ----------
scan_artifacts() {
  cat_in artifacts || return 0
  local root="$TARGET"
  [[ -d $root ]] || return 0
  local root_sz
  root_sz=$(path_size "$root")
  if (( root_sz > 50*1024*1024*1024 )) && (( ! DEEP )); then
    add_skip "$root" "tree >50GB; use --deep to scan"
    return 0
  fi

  local hit parent artname
  local -a hits=()
  while IFS= read -r hit; do
    hits+=("$hit")
  done < <( bounded_find "$root" -xdev \
      \( -name .git -o -path "$HOME/.cache" -o -path "$HOME/.local/share/Trash" \
         -o -path "$HOME/snap" -o -path "$HOME/.var" -o -path "$HOME/.npm" \
         -o -path "$HOME/.cargo/registry" -o -path "$HOME/.rustup" \
         -o -path "$HOME/Library/Caches" \
         -o -path '*/node_modules/*' -o -path '*/target/*' -o -path '*/.next/*' \) -prune -o \
      -type d \( -name node_modules -o -name target -o -name __pycache__ \
                 -o -name .pytest_cache -o -name .mypy_cache -o -name .ruff_cache \
                 -o -name .tox -o -name .next -o -name build -o -name dist \) -prune -print 2>/dev/null )

  for hit in "${hits[@]}"; do
    parent=$(dirname "$hit")
    artname=$(basename "$hit")
    case "$artname" in
      node_modules) [[ -f $parent/package.json ]] || continue ;;
      target)       [[ -f $parent/Cargo.toml   ]] || continue ;;
      .next)        [[ -f $parent/package.json ]] || continue ;;
      build)        [[ -f $parent/build.gradle || -f $parent/build.gradle.kts ]] || continue ;;
    esac
    local projroot="$parent"
    local probe="$parent"
    for _ in 1 2 3; do
      if [[ -f $probe/.git/HEAD || -d $probe/.git ]]; then break; fi
      probe=$(dirname "$probe")
      [[ $probe == / || $probe == "$HOME" ]] && break
    done
    local last=0
    if [[ -d $probe/.git ]]; then
      last=$(git -C "$probe" log -1 --format=%ct 2>/dev/null || echo 0)
    fi
    (( last == 0 )) && last=$(stat_mtime "$hit" 2>/dev/null || echo 0)
    local age=$(( ( $(date +%s) - last ) / 86400 ))
    if (( ! DEEP )) && (( age < 30 )); then
      add_skip "$hit" "active project (used ${age}d ago)"; continue
    fi
    local sz
    sz=$(path_size "$hit")
    (( sz > 0 )) || continue
    add_cand "$sz" "artifacts" "$hit" "$artname in $parent (project idle ${age}d)"
  done
}

# ---------- category: installers ----------
scan_installers() {
  cat_in installers || return 0
  local -a name_tests=(-iname '*.deb' -o -iname '*.rpm' -o -iname '*.run' -o -iname '*.iso'
    -o -iname '*.img' -o -iname '*.snap' -o -iname '*.flatpak' -o -iname '*.flatpakref' -o -iname '*.appimage'
    -o -iname '*.dmg' -o -iname '*.pkg')
  local files=() f
  while IFS= read -r f; do files+=("$f"); done < <(
    { find "$HOME/Downloads" "$HOME/Desktop" -maxdepth 3 -type f \( "${name_tests[@]}" \) 2>/dev/null
      find "$HOME" -maxdepth 1 -type f \( "${name_tests[@]}" \) 2>/dev/null
    } | sort -u | head -200 )
  for f in "${files[@]}"; do
    cache_candidate_ok "$f" || { add_skip "$f" "sensitive/protected"; continue; }
    local sz; sz=$(path_size "$f")
    (( sz > 0 )) || continue
    add_cand "$sz" "installers" "$f" "installer file"
  done
}

# ---------- category: large files ----------
scan_large() {
  cat_in large || return 0
  local thr=$(( MIN_LARGE_MB * 1024 * 1024 ))
  local f sz
  while IFS= read -r f; do
    [[ -e $f ]] || continue
    is_protected "$f" && continue
    is_sensitive "$f" && continue
    sz=$(path_size "$f")
    (( sz >= thr )) || continue
    add_cand "$sz" "large" "$f" "large file (>=${MIN_LARGE_MB}MB)"
  done < <( bounded_find "$TARGET" -xdev \
      \( -name .git -o -name node_modules -o -name target -o -path '*/.cache/*' \) -prune -o \
      -type f -size +"$((MIN_LARGE_MB-1))"M -print 2>/dev/null | head -200 )
}

main() {
# ---------- run scans ----------
scan_trash; scan_browsers; scan_dev; scan_cache; scan_system; scan_snap
scan_flatpak; scan_docker; scan_artifacts; scan_installers; scan_large

# ---------- output ----------
if (( ${#CANDS[@]} > 0 )); then
  tmpf=$(mktemp)
  printf '%s\n' "${CANDS[@]}" | sort -t"$(printf '\t')" -k1,1rn > "$tmpf"
  CANDS=()
  while IFS= read -r line; do CANDS+=("$line"); done < "$tmpf"
  rm -f "$tmpf"
fi

if (( JSON )); then
  printf '{\n  "version": "%s",\n  "keep_days": %d,\n  "deep": %d,\n  "candidates": [\n' "$SMARTCLEAN_VERSION" "$KEEP_DAYS" "$DEEP"
  local i=0
  for c in "${CANDS[@]}"; do
    IFS=$'\t' read -r sz cat path reason <<<"$c"
    (( i > 0 )) && printf ',\n'
    printf '    {"size": %s, "category": "%s", "path": "%s", "reason": "%s"}' "$sz" "$cat" "${path//\"/\\\"}" "${reason//\"/\\\"}"
    i=$((i+1))
  done
  printf '\n  ],\n  "skipped": [\n'
  i=0
  for s in "${SKIPS[@]}"; do
    IFS=$'\t' read -r path reason <<<"$s"
    (( i > 0 )) && printf ',\n'
    printf '    {"path": "%s", "reason": "%s"}' "${path//\"/\\\"}" "${reason//\"/\\\"}"
    i=$((i+1))
  done
  printf '\n  ]\n}\n'
  exit 0
fi

# human report
printf '%s\n' "${C_BOLD}smartclean scan${C_RESET} — smart disk analysis (no changes)$( (( DRY_RUN )) && printf ' %s' "${C_YELLOW}(dry run)${C_RESET}")"
printf '%s\n' "${C_DIM}keep-days=${KEEP_DAYS} deep=${DEEP} target=${TARGET}${C_RESET}"
printf '\n'

total=0
for c in "${CANDS[@]}"; do
  IFS=$'\t' read -r sz cat path reason <<<"$c"
  total=$((total + sz))
done

printf '%s\n' "${C_BOLD}Candidates (ranked by size):${C_RESET}"
if (( ${#CANDS[@]} == 0 )); then
  printf '  %s nothing to clean${C_RESET}\n' "${C_DIM}"
else
  local sz cat path reason
  for c in "${CANDS[@]}"; do
    IFS=$'\t' read -r sz cat path reason <<<"$c"
    printf '  %8s  %-11s  %s  %s\n' "$(human_size "$sz")" "[$cat]" "${path/#$HOME/\~}" "${C_DIM}$reason${C_RESET}"
  done
  printf '\n  %s total: %s in %d item(s)%s\n' "${C_BOLD}" "$(human_size "$total")" "${#CANDS[@]}" "${C_RESET}"
fi

printf '\n%s\n' "${C_BOLD}Category totals:${C_RESET}"
for cat in trash browsers dev cache system snap flatpak docker artifacts installers large; do
  cnt=0; tot=0
  for c in "${CANDS[@]}"; do
    IFS=$'\t' read -r sz ccat path reason <<<"$c"
    [[ $ccat == "$cat" ]] || continue
    cnt=$((cnt+1)); tot=$((tot+sz))
  done
  (( cnt == 0 )) && continue
  printf '  %-11s %8s  (%d item(s))\n' "$cat" "$(human_size "$tot")" "$cnt"
done

printf '\n%s\n' "${C_BOLD}Smart skips (${#SKIPS[@]}):${C_RESET}"
shown=0
for s in "${SKIPS[@]}"; do
  IFS=$'\t' read -r path reason <<<"$s"
  printf '  %s  %s\n' "${path/#$HOME/\~}" "${C_DIM}$reason${C_RESET}"
  shown=$((shown+1))
  (( shown >= 25 )) && { printf '  %s... (%d more)%s\n' "${C_DIM}" "$(( ${#SKIPS[@]} - shown ))" "${C_RESET}"; break; }
done

printf '\n%s\n' "${C_DIM}Run 'smartclean apply' to delete (confirms per category). Use --apply --yes to skip prompts.${C_RESET}"

# ---------- apply mode ----------
if (( APPLY )); then
  printf '\n%s\n' "${C_BOLD}=== APPLY MODE ===${C_RESET}"
  DRY_RUN=0
  local cat
  for cat in trash browsers dev cache system snap flatpak docker artifacts installers large; do
    local items=()
    for c in "${CANDS[@]}"; do
      IFS=$'\t' read -r sz ccat path reason <<<"$c"
      [[ $ccat == "$cat" ]] && items+=("$path")
    done
    (( ${#items[@]} == 0 )) && continue
    printf '\n%s %s (%d item(s))%s\n' "${C_BOLD}" "$cat" "${#items[@]}" "${C_RESET}"
    if ! confirm_or_dry "Delete all $cat candidates?"; then
      printf '  skipped\n'; continue
    fi
    case "$cat" in
      trash|browsers|dev|cache|flatpak|artifacts|installers|large)
        for p in "${items[@]}"; do safe_rm "$p"; done ;;
      system)
        if have brew; then
          if confirm_or_dry "Run brew cleanup?"; then
            brew cleanup 2>/dev/null || true
          fi
        fi
        if [[ -d /var/cache/apt/archives ]]; then
          local sz; sz=$(path_size /var/cache/apt/archives)
          if (( sz > 100*1024 )); then
            if confirm_or_dry "Clear apt cache ($(human_size "$sz"))?"; then
              if (( EUID == 0 )); then apt-get clean; else sudo apt-get clean; fi
              TOTAL_FREED=$((TOTAL_FREED + sz))
            fi
          fi
        fi
        if have journalctl; then
          if confirm_or_dry "Trim journal to 7 days?"; then
            if (( EUID == 0 )); then journalctl --vacuum-time=7d; else sudo journalctl --vacuum-time=7d; fi
          fi
        fi
        if confirm_or_dry "Delete rotated logs in /var/log?"; then
          if (( EUID == 0 )); then
            find /var/log -xdev -type f \( -name '*.gz' -o -name '*.old' -o -name '*.[0-9]' \) -delete
          else
            sudo find /var/log -xdev -type f \( -name '*.gz' -o -name '*.old' -o -name '*.[0-9]' \) -delete
          fi
        fi
        ;;
      snap)
        local line
        while IFS= read -r line; do
          [[ -z $line ]] && continue
          local name=${line%%=*} rev=${line##*=}
          if confirm_or_dry "Remove snap $name rev $rev?"; then
            if (( EUID == 0 )); then snap remove "$name" --revision="$rev"; else sudo snap remove "$name" --revision="$rev"; fi
          fi
        done < <(snap list --all 2>/dev/null | awk '/disabled/{print $1"="$3}')
        local snaps
        snaps=$(snap saved 2>/dev/null | tail -n +2)
        if [[ -n $snaps && $snaps != *"No snapshots"* ]]; then
          while read -r sset sname sage rest; do
            [[ $sset =~ ^[0-9]+$ ]] || continue
            if confirm_or_dry "Forget snap snapshot #$sset ($sname)?"; then
              if (( EUID == 0 )); then snap forget "$sset"; else sudo snap forget "$sset"; fi
            fi
          done <<<"$snaps"
        fi
        ;;
      docker)
        for ce in docker podman; do
          have "$ce" || continue
          "$ce" system df >/dev/null 2>&1 || continue
          if confirm_or_dry "Prune $ce dangling images + build cache?"; then
            "$ce" image prune -f 2>/dev/null
            "$ce" builder prune -f 2>/dev/null
          fi
          local stopped
          stopped=$("$ce" ps -a --filter status=exited --filter status=created --filter status=dead --format '{{.Names}}' 2>/dev/null)
          if [[ -n $stopped ]]; then
            printf '  stopped containers:\n%s\n' "$stopped" | sed 's/^/    /'
            if confirm_or_dry "Remove ALL stopped $ce containers?"; then
              "$ce" container prune -f 2>/dev/null
            fi
          fi
          if (( DEEP )); then
            if confirm_or_dry "Deep: remove unused $ce images?"; then
              "$ce" image prune -a -f 2>/dev/null
            fi
          fi
        done
        ;;
    esac
  done
  printf '\n%s\n' "${C_BOLD}${C_GREEN}Freed (estimated): $(human_size "$TOTAL_FREED")${C_RESET}"
fi
}
main "$@"
